#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            compatible = "zmk,keymap-layer";
            bindings = <
// -----------------------------------------------------------------------------------------
// |  TAB  |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  | BSPC  |
// |  ESC  |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |  '    |
// | SHIFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | SHIFT |
//                    | CTRL | LWR/SPC | ALT |   | ENT | RSHF| GUI |
&kp TAB   &kp Q        &kp W        &kp E         &kp R         &kp T             &kp Y         &kp U         &kp I         &kp O        &kp P           &kp BSPC
&kp ESC   &mt LCTRL A  &mt LALT S   &mt LGUI D    &mt LSHFT F   &kp G             &kp H         &mt RSHFT J   &mt RGUI K    &mt RALT L   &mt RCTRL SEMI  &kp SQT
&kp LSHFT &kp Z        &kp X        &kp C         &kp V         &kp B             &kp N         &kp M         &kp COMMA     &kp DOT      &kp SLASH       &kp RSHFT
                                    &kp LCTRL     &lt 1 SPACE   &kp LALT          &kp ENTER     &mo 2         &kp RGUI
            >;
        };

        lower_layer {
            compatible = "zmk,keymap-layer";
            bindings = <
&kp GRAVE  &kp N1       &kp N2       &kp N3       &kp N4       &kp N5             &kp N6       &kp N7       &kp N8       &kp N9       &kp N0       &kp DEL
&trans     &trans       &trans       &trans       &trans       &trans             &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT    &trans       &trans
&trans     &trans       &trans       &trans       &trans       &trans             &trans       &trans       &trans       &trans       &trans       &trans
                                     &trans       &trans       &trans             &trans       &trans       &trans
            >;
        };

        raise_layer {
            compatible = "zmk,keymap-layer";
            bindings = <
&kp F1     &kp F2       &kp F3       &kp F4       &kp F5       &kp F6             &kp F7       &kp F8       &kp F9       &kp F10      &kp F11      &kp F12
&trans     &kp MINUS    &kp EQUAL    &kp LBKT     &kp RBKT     &kp BSLH           &kp HOME     &kp PG_DN    &kp PG_UP    &kp END      &trans       &trans
&trans     &kp C_VOL_DN &kp C_MUTE   &kp C_VOL_UP &trans       &trans             &kp C_PREV   &kp C_PP     &kp C_NEXT   &trans       &trans       &trans
                                     &trans       &trans       &trans             &trans       &trans       &trans
            >;
        };
    };
};